<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Roosterfish Marine</title>
   
    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- POPPINS -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS GLOBAL -->
    <link rel="stylesheet" href="~/css/Index.css" />

    <!-- CSS EXTRA POR PÁGINA -->
    @RenderSection("Styles", required: false)

</head>
<body>

    <!-- HEADER GLOBAL (UNO SOLO PARA TODO) -->
    <header class="main-header d-flex align-items-center justify-content-between px-4">
        <div class="img-logo">
            <img src="~/img/logo_rooster_transparent.png" style="height:70px;">
            <span class="logo-text">ROOSTERFISH M</span>
        </div>

        <nav class="d-flex">
            <a class="nav-link" href="/">Home</a>
            <a class="nav-link" href="#">Activities & Tours</a>
            <a class="nav-link" asp-controller="Gallery" asp-action="Index">Gallery</a>
            <a class="nav-link" asp-controller="Contact" asp-action="Index">Contact</a>
        </nav>
    </header>

    @RenderBody()

</body>
</html>