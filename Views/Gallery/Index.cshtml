@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/gallery.css" />
}

<!-- HERO IGUAL AL INDEX -->
<section class="header-full">

    <div class="hero-text">
        <h1>Gallery</h1>
        <p>Explore our best moments at sea</p>
    </div>

</section>

<!-- GALERÍA -->
<section class="gallery-section py-5">
    <div class="container">

        <h2 class="text-center mb-5 fw-bold">Moments</h2>

        <div class="row g-4">

            <div class="col-12 col-md-4">
                <img src="/img/1.jpg" class="gallery-img">
            </div>

            <div class="col-12 col-md-4">
                <img src="/img/2.jpg" class="gallery-img">
            </div>

            <div class="col-12 col-md-4">
                <img src="/img/3.jpg" class="gallery-img">
            </div>

            <div class="col-12 col-md-4">
                <img src="/img/4.jpg" class="gallery-img">
            </div>

            <div class="col-12 col-md-4">
                <img src="/img/5.jpg" class="gallery-img">
            </div>

            <div class="col-12 col-md-4">
                <img src="/img/6.jpg" class="gallery-img">
            </div>

        </div>

    </div>
</section>