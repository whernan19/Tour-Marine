<link rel="stylesheet" href="~/css/Gallery.css" />
@{
    var galeria = new List<dynamic>
{
        new { Tipo = "img", Src = "/img/pez.jpeg" },
        new { Tipo = "video", Src = "/img/Pesca-El-Jobo-La-Cruz-Guanacaste-Costa-Rica.mp4", Preview = "/img/rooster.jpeg" },
        new { Tipo = "img", Src = "/img/sunset.jpeg" },
        new { Tipo = "video", Src = "/img/sport-fishing-el-jobo-costa-rica-guanacaste.mp4", Preview = "/img/sunset.jpeg" },
        new { Tipo = "img", Src = "/img/roosterfish.LaCruz.CostaRica.jpeg" },
       
    };
}

<div class="gallery">
    @foreach (var item in galeria)
    {
        if (item.Tipo == "img")
        {
            <div class="card">
                <img src="@item.Src" alt="galeria" />
            </div>
        }
        else
        {
            <div class="card video-card">
                <video preload="none" poster="@item.Preview">
                    <source src="@item.Src" type="video/mp4">
                </video>
            </div>
        }
    }
</div>
<script>
    document.querySelectorAll('.video-card').forEach(card => {

        const video = card.querySelector('video');

        card.addEventListener('click', (e) => {
            e.stopPropagation();

            if (video.paused) {
                video.play();
                card.classList.add('playing');
            } else {
                video.pause();
                card.classList.remove('playing');
            }
        });

        // Cuando termina el video
        video.addEventListener('ended', () => {
            card.classList.remove('playing');
        });

    });
</script>